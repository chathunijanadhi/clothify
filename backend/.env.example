# Neon/PostgreSQL connection string. HostDatabase is supported for existing deployments.
# Use one of these connection string variables instead of the DB_* variables below.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# HostDatabase=postgresql://user:password@host/database?sslmode=require

# Admin seed credentials (keep these values only in backend/.env or deployment secrets)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD="replace-with-a-strong-password"
# ADMIN_NAME=Administrator

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=clothify_local
DB_PASSWORD=clothify_local_password
DB_DATABASE=clothify_local
JWT_SECRET=EXAMPLE_ONLY_REPLACE_WITH_A_RANDOM_SECRET_OF_32_PLUS_CHARACTERS

# Allow both local Vite dev and deployed frontend
FRONTEND_URL=http://localhost:5173,https://clothify-one.vercel.app
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000
REQUEST_TIMEOUT_MS=30000
REQUEST_BODY_LIMIT=1mb
TRUST_PROXY=0
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=10000
DB_CONNECT_MAX_ATTEMPTS=5
DB_CONNECT_RETRY_BASE_DELAY_MS=500
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# Cloudinary configuration - set these values (replace with your real values locally)
# Only API key and API secret are required to be set by you (the cloud name is helpful too)
CLOUDINARY_CLOUD_NAME=xxxxx
CLOUDINARY_API_KEY=xxxxx
CLOUDINARY_API_SECRET=xxxxxx
