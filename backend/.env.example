# Neon/PostgreSQL connection string. HostDatabase is supported for existing deployments.
# Use one of these connection string variables instead of the DB_* variables below.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# HostDatabase=postgresql://user:password@host/database?sslmode=require

# Admin seed credentials (keep these values only in backend/.env or deployment secrets)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD="replace-with-a-strong-password"
# ADMIN_NAME=Administrator

DB_HOST=localhost
DB_PORT=xxxx
DB_USERNAME=postgres
DB_PASSWORD=xxxxx
DB_DATABASE=xxxxx

# Allow both local Vite dev and deployed frontend
FRONTEND_URL=http://localhost:5173,https://clothify-one.vercel.app

# Cloudinary configuration - set these values (replace with your real values locally)
# Only API key and API secret are required to be set by you (the cloud name is helpful too)
CLOUDINARY_CLOUD_NAME=xxxxx
CLOUDINARY_API_KEY=xxxxx
CLOUDINARY_API_SECRET=xxxxxx
